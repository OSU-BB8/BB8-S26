(footprint "Switch_2Pin_5mm_ParallelBlades"
  (version 20240108)
  (generator pcbnew)
  (layer "F.Cu")
  (descr "2-pin panel switch, parallel blade leads, 5.0 mm pitch; measured leads 0.55 x 2.75 mm")
  (tags "switch 2pin panel parallel blade 5mm")
  (attr through_hole)
  (fp_rect (start -4 -3) (end 9 3)
    (stroke (width 0.25) (type default)) (fill none) (layer "F.SilkS"))
  (fp_circle (center -3.2 -2.2) (end -3 -2.2)
    (stroke (width 0.4) (type default)) (fill none) (layer "F.SilkS"))
  (fp_rect (start -4.25 -3.25) (end 9.25 3.25)
    (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (fp_text reference "SW?" (at 2.5 -4.2 0) (layer "F.SilkS")
    (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "Switch_2Pin_5mm" (at 2.5 4.2 0) (layer "F.Fab")
    (effects (font (size 1 1) (thickness 0.15))))
  (pad "1" thru_hole rect (at 0 0 90) (size 3.4 1.4) (drill oval 2.95 0.8) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole oval (at 5 0 90) (size 3.4 1.4) (drill oval 2.95 0.8) (layers "*.Cu" "*.Mask"))
)
